<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SensorBlocker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_700</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/badge_bg</item>
        <item name="colorSecondary">@color/cyan_800</item>
        <item name="android:statusBarColor">@color/teal_700</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="materialCardViewStyle">@style/Widget.SensorBlocker.Card</item>
    </style>

    <style name="Widget.SensorBlocker.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline</item>
    </style>
</resources>
